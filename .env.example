# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the browser. Used for account deletion and AI quota checks.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of this deployment (used in auth email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Gemini (Google AI Studio key from a billing-enabled GCP project) ---
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_SMART=gemini-2.5-pro

# --- AI cost controls ---
AI_LIMIT_ANALYSIS=5          # deep analyses per user per month
AI_LIMIT_PARSE=100           # text + receipt parses per user per month
AI_GLOBAL_DAILY_LIMIT=300    # all AI calls per day, whole instance
