# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the browser. Used for account deletion and AI quota checks.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of this deployment (used in auth email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI provider ---
# gemini | claude | openai  (default gemini). "mock" returns fixtures; dev/E2E only, refused in production.
AI_PROVIDER=gemini
# Only the selected provider's key is needed.
GEMINI_API_KEY=              # Google AI Studio key from a billing-enabled GCP project
CLAUDE_API_KEY=              # console.anthropic.com
OPENAI_API_KEY=              # platform.openai.com
# Optional model overrides (defaults per provider: gemini-2.5-flash/pro, claude-haiku-5-5/claude-sonnet-5-5, gpt-5.4-mini/gpt-5.5)
AI_MODEL_FAST=
AI_MODEL_SMART=
# Legacy, still honoured when AI_PROVIDER=gemini
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_SMART=gemini-2.5-pro

# --- AI cost controls ---
AI_LIMIT_ANALYSIS=5          # deep analyses per user per month
AI_LIMIT_PARSE=100           # text + receipt parses per user per month
AI_LIMIT_ORGANIZE=20         # AI tidy-up runs (categories, merchants, item names, anomaly scan) per user per month
AI_LIMIT_CHAT=50             # "ask your data" questions per user per month
AI_GLOBAL_DAILY_LIMIT=300    # all AI calls per day, whole instance
